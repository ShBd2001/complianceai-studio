# --- Application ---
APP_NAME="ComplianceAI Studio"
ENV=development
DEBUG=true

# --- Base de donnees ---
DATABASE_URL=postgresql+psycopg://compliance:compliance@localhost:5432/complianceai

# --- Securite ---
# Generer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Origine du frontend (liens dans les e-mails) ---
FRONTEND_URL=http://localhost:5173

# --- E-mail transactionnel ---
# SMTP_HOST vide : aucun envoi reseau, le message est ecrit dans
# STORAGE_DIR/emails/ (lisible directement, parcours testable sans compte externe).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Fournisseur LLM ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_ENABLED=true
LLM_TEMPERATURE=0.0
LLM_MAX_CONCURRENCY=3
AUDIT_MAX_SECONDS=240
LLM_BREAKER_THRESHOLD=3

# --- Vectorisation ---
# fastembed : modele local multilingue (384 dim). hashing : repli sans modele.
EMBEDDING_BACKEND=fastembed
EMBEDDING_DIM=384

# --- Stockage et RAG ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20
RAG_TOP_K=3
PROMPT_REQUIREMENT_CHARS=1500
PROMPT_PASSAGE_CHARS=600

# --- Planification (veille reglementaire + campagnes recurrentes) ---
# Desactivee par defaut : interroge EUR-Lex sur un minuteur et peut executer
# des campagnes d'audit (donc consommer du quota Groq) sans supervision
# humaine. A activer sciemment.
SCHEDULER_ENABLED=false
SCHEDULER_POLL_SECONDS=300
REGULATORY_WATCH_INTERVAL_HOURS=24
